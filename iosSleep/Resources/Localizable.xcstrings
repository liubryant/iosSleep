        }
      }
    },
    "当前设备不支持 Apple 健康。睡眠洞察需要在支持健康 App 的 iPhone 上使用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设备不支持 Apple 健康。睡眠洞察需要在支持健康 App 的 iPhone 上使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health is not currently supported on the device. Sleep Insights requires an iPhone that supports the Health app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health は現在デバイスでサポートされていません。 Sleep Insights には、ヘルスケア アプリをサポートする iPhone が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health wird derzeit auf dem Gerät nicht unterstützt. Für Sleep Insights ist ein iPhone erforderlich, das die Health-App unterstützt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health n'est actuellement pas pris en charge sur l'appareil. Sleep Insights nécessite un iPhone prenant en charge l’application Santé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente, Apple Health no es compatible con el dispositivo. Sleep Insights requiere un iPhone que admita la aplicación Salud."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前裝置不支援 Apple 健康。睡眠洞察需要在支援健康 App 的 iPhone 上使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health는 현재 해당 장치에서 지원되지 않습니다. 수면 통계를 사용하려면 건강 앱을 지원하는 iPhone이 필요합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health غير مدعوم حاليًا على الجهاز. تتطلب Sleep Insights جهاز iPhone يدعم تطبيق Health."
          }
        }
      }
    },
