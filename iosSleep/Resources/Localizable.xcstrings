    "我更喜欢独自待着，而不是参加聚会": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我更喜欢独自待着，而不是参加聚会"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I prefer to be alone rather than go to parties"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私はパーティーに行くよりも一人でいることを好みます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin lieber allein, als auf Partys zu gehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je préfère être seul plutôt que d'aller à des fêtes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefiero estar solo que ir a fiestas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我更喜歡獨自待著，而不是參加聚會"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 파티에 가는 것보다 혼자 있는 것을 더 좋아한다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفضّل أن أكون وحدي بدلاً من الذهاب إلى الحفلات"
          }
        }
      }
    },
    "睡眠问题影响了工作、学习或情绪": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠问题影响了工作、学习或情绪"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep problems affect work, study or mood"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠の問題は仕事、勉強、気分に影響を与えます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafprobleme beeinträchtigen die Arbeit, das Lernen oder die Stimmung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les problèmes de sommeil affectent le travail, les études ou l'humeur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los problemas de sueño afectan el trabajo, el estudio o el estado de ánimo"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠問題影響了工作、學習或情緒"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 문제는 일, 공부 또는 기분에 영향을 미칩니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤثر مشاكل النوم على العمل أو الدراسة أو الحالة المزاجية"
          }
        }
      }
    },
    "照顾全局时也要诚实表达自己的疲惫、边界和真实期待。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照顾全局时也要诚实表达自己的疲惫、边界和真实期待。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be honest about your exhaustion, boundaries, and true expectations while taking care of the big picture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体像を考慮しながら、自分の疲労、限界、本当の期待について正直になってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seien Sie ehrlich über Ihre Erschöpfung, Ihre Grenzen und Ihre wahren Erwartungen, während Sie sich um das Gesamtbild kümmern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez honnête à propos de votre épuisement, de vos limites et de vos véritables attentes tout en prenant soin de la situation dans son ensemble."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sea honesto acerca de su agotamiento, sus límites y sus verdaderas expectativas mientras se ocupa del panorama general."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "照顧全局時也要誠實表達自己的疲憊、界線和真實期待。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "큰 그림을 다루면서 자신의 피로감, 경계, 진정한 기대에 대해 솔직해지세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كن صادقًا بشأن إرهاقك وحدودك وتوقعاتك الحقيقية أثناء الاهتمام بالصورة الكبيرة."
          }
        }
      }
    },
    "本测评用于自我觉察，不构成医疗诊断或治疗建议。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本测评用于自我觉察，不构成医疗诊断或治疗建议。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assessment is for self-awareness and does not constitute medical diagnosis or treatment advice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この評価は自己認識を目的としたものであり、医学的診断や治療上のアドバイスを構成するものではありません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Beurteilung dient der Selbsterkenntnis und stellt keine medizinische Diagnose oder Behandlungsberatung dar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette évaluation est destinée à la conscience de soi et ne constitue pas un diagnostic médical ou un conseil de traitement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta evaluación es para el autoconocimiento y no constituye un diagnóstico médico ni un consejo de tratamiento."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "本評測用於自我覺察，不構成醫療診斷或治療建議。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 평가는 자기 인식을 위한 것이며 의학적 진단이나 치료 조언을 구성하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التقييم مخصص للوعي الذاتي ولا يشكل تشخيصًا طبيًا أو نصيحة علاجية."
          }
        }
      }
    },
    "暂无足够数据生成睡眠分布。": {
