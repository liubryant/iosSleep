    "比起操作细节，我更容易被概念和整体图景吸引": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比起操作细节，我更容易被概念和整体图景吸引"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm more attracted to concepts and big picture than operational details"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運用の詳細よりもコンセプトや全体像に惹かれる"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzepte und das Gesamtbild interessieren mich mehr als operative Details"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis plus attiré par les concepts et la vision d'ensemble que par les détails opérationnels"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me atraen más los conceptos y el panorama general que los detalles operativos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "比起操作細節，我更容易被概念和整體圖像吸引"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 운영 세부 사항보다 개념과 큰 그림에 더 매력을 느낍니다."
          }
