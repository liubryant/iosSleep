          }
        }
      }
    },
    "动手能力强、判断务实，面对压力时通常能抓住关键。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动手能力强、判断务实，面对压力时通常能抓住关键。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "He has strong practical skills and pragmatic judgment, and can usually grasp the key when facing pressure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "彼は強力な実践スキルと現実的な判断力を備えており、プレッシャーに直面したときでも鍵を握ることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er verfügt über ausgeprägte praktische Fähigkeiten und ein pragmatisches Urteilsvermögen und kann in der Regel den Schlüssel verstehen, wenn er unter Druck steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il possède de solides compétences pratiques et un jugement pragmatique, et peut généralement saisir la clé face à la pression."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene fuertes habilidades prácticas y juicio pragmático y, por lo general, puede captar la clave cuando enfrenta presión."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "動手能力強、判斷務實，面對壓力時通常能抓住關鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그는 탄탄한 실무 능력과 실용적인 판단력을 갖고 있으며, 압박에 직면했을 때 대개 열쇠를 쥐는 능력을 갖추고 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتمتع بمهارات عملية قوية وحكم عملي، ويمكنه عادةً فهم المفتاح عند مواجهة الضغط."
          }
        }
      }
    },
