    "为了房子，人间闹了多少悲剧": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了房子，人间闹了多少悲剧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many tragedies have been caused in the world because of the house?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家のせいで世界中でどれだけの悲劇が引き起こされているのでしょうか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Tragödien wurden weltweit wegen des Hauses verursacht?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de tragédies ont été causées dans le monde à cause de la maison ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuántas tragedias se han causado en el mundo a causa de la casa?"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "為了房子，人間鬧了多少悲劇"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집 때문에 세상에 얼마나 많은 비극이 일어났습니까?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كم من مآسي حدثت في العالم بسبب المنزل؟"
          }
        }
      }
    },
