    "说明越具体直接，我越容易理解和执行": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明越具体直接，我越容易理解和执行"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The more specific and direct the instructions are, the easier it is for me to understand and follow them"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示がより具体的で直接的であればあるほど、理解しやすく、従いやすくなります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je konkreter und direkter die Anweisungen sind, desto leichter kann ich sie verstehen und befolgen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus les instructions sont précises et directes, plus il m'est facile de les comprendre et de les suivre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más específicas y directas sean las instrucciones, más fácil me resultará entenderlas y seguirlas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "說明越具體直接，我越容易理解和執行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지시사항이 구체적이고 직접적일수록 지시사항을 이해하고 따르기가 더 쉬워집니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما كانت التعليمات محددة ومباشرة، كان من الأسهل بالنسبة لي أن أفهمها وأتبعها"
          }
        }
      }
    },
    "搜索雨声、森林、海浪": {
      "localizations": {
