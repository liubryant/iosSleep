    "近期紧张和担忧处在较低水平。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期紧张和担忧处在较低水平。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tensions and worries are at low levels recently."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近、緊張と心配は低いレベルにあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spannungen und Sorgen sind zuletzt auf einem niedrigen Niveau."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tensions et les inquiétudes sont à leur plus bas niveau ces derniers temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tensiones y preocupaciones están en niveles bajos últimamente."
          }
        },
        "zh-HK": {
