          }
        }
      }
    },
    "讨论问题时，我常常边说边形成自己的想法": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "讨论问题时，我常常边说边形成自己的想法"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When discussing issues, I often formulate my own ideas while talking"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題について議論するとき、私は話しながら自分のアイデアを組み立てることがよくあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich über Themen diskutiere, formuliere ich im Gespräch oft meine eigenen Ideen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque je discute de problèmes, je formule souvent mes propres idées tout en parlant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hablo de temas, a menudo formulo mis propias ideas mientras hablo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "討論問題時，我常常邊說邊形成自己的想法"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 문제를 논의할 때 대화를 나누면서 내 생각을 정리하는 경우가 많다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند مناقشة القضايا، غالبًا ما أقوم بصياغة أفكاري الخاصة أثناء الحديث"
          }
        }
      }
    },
    "收藏喜欢的声音后会显示在这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏喜欢的声音后会显示在这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collecting your favorite sounds will be displayed here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りのサウンドを集めたものがここに表示されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sammlung Ihrer Lieblingssounds wird hier angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La collecte de vos sons préférés sera affichée ici."
          }
        },
        "es": {
