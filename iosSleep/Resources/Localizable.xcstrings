    "请先阅读并同意会员、自动续费、隐私政策和使用条款": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先阅读并同意会员、自动续费、隐私政策和使用条款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please read and agree to membership, automatic renewal, privacy policy and terms of use first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは会員登録、自動更新、プライバシーポリシー、利用規約を読んで同意してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lesen Sie zuerst die Mitgliedschaft, die automatische Verlängerung, die Datenschutzbestimmungen und die Nutzungsbedingungen und stimmen Sie diesen zu"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez d'abord lire et accepter l'adhésion, le renouvellement automatique, la politique de confidentialité et les conditions d'utilisation."
          }
        },
        "es": {
          "stringUnit": {
