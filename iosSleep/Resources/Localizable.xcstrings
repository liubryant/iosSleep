    "觉察身心负荷与恢复": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "觉察身心负荷与恢复"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awareness of physical and mental load and recovery"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
