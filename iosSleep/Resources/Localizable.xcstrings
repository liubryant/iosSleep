            "state": "translated",
            "value": "Normalmente estoy más tranquilo en lugares concurridos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在人多的場合，我通常比較安靜"
          }
        },
