    "心上有个人，才能活下去": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心上有个人，才能活下去"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when you have someone in your heart can you survive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心に誰かがいてこそ人は生きていける"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn du jemanden in deinem Herzen hast, kannst du überleben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est que lorsque tu as quelqu'un dans ton cœur que tu peux survivre"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo cuando tienes a alguien en tu corazón puedes sobrevivir."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "心上有個人，才能活下去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음속에 누군가가 있어야만 살아남을 수 있다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط عندما يكون لديك شخص ما في قلبك، يمكنك البقاء على قيد الحياة"
          }
        }
      }
    },
