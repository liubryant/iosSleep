        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深い睡眠時間"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefschlafdauer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "durée du sommeil profond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "duración del sueño profundo"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "深睡時長"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊은 수면 시간"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدة النوم العميق"
          }
        }
      }
    },
    "发现思绪飘走时，不必责备自己，轻轻觉察，再慢慢回到当下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现思绪飘走时，不必责备自己，轻轻觉察，再慢慢回到当下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you find that your thoughts are drifting away, don't blame yourself, just notice it gently, and then slowly return to the present moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の考えが遠ざかってしまったときは、自分を責めずに、そっとそれに気づいて、ゆっくりと今この瞬間に戻ってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie feststellen, dass Ihre Gedanken abschweifen, machen Sie sich keine Vorwürfe, bemerken Sie es einfach sanft und kehren Sie dann langsam in den gegenwärtigen Moment zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous constatez que vos pensées s'éloignent, ne vous blâmez pas, remarquez-le simplement doucement, puis revenez lentement au moment présent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando descubras que tus pensamientos se están alejando, no te culpes, simplemente obsérvalo suavemente y luego regresa lentamente al momento presente."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "發現思緒飄走時，不必責備自己，輕輕覺察，再慢慢回到當下。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 생각이 표류하고 있다는 것을 발견했을 때, 자신을 비난하지 말고, 단지 그것을 부드럽게 알아차린 다음 천천히 현재의 순간으로 돌아오십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تجد أن أفكارك تنجرف بعيدًا، لا تلوم نفسك، فقط لاحظ ذلك بلطف، ثم عد ببطء إلى اللحظة الحالية."
          }
        }
      }
    },
    "提倡者": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提倡者"
          }
        },
        "en": {
