    "选择能发挥自然偏好、同时允许补足弱项的环境。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择能发挥自然偏好、同时允许补足弱项的环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an environment that brings out your natural preferences while allowing you to complement your weaknesses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の弱点を補いながら、本来の好みを引き出してくれる環境を選びましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Umgebung, die Ihre natürlichen Vorlieben zum Ausdruck bringt und es Ihnen gleichzeitig ermöglicht, Ihre Schwächen auszugleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un environnement qui fait ressortir vos préférences naturelles tout en vous permettant de compléter vos faiblesses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un entorno que resalte sus preferencias naturales y al mismo tiempo le permita complementar sus debilidades."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇能發揮自然偏好、同時允許補足弱項的環境。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 약점을 보완하면서 자연스러운 선호도를 끌어낼 수 있는 환경을 선택하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بيئة تبرز تفضيلاتك الطبيعية بينما تسمح لك باستكمال نقاط ضعفك."
          }
        }
      }
    },
    "建议尽早向睡眠门诊或专业人员寻求评估。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议尽早向睡眠门诊或专业人员寻求评估。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is recommended to seek evaluation from a sleep clinic or professional as early as possible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "できるだけ早く睡眠クリニックや専門家の診断を受けることをお勧めします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird empfohlen, sich so früh wie möglich von einer Schlafklinik oder einem Schlafmediziner untersuchen zu lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est recommandé de demander une évaluation à une clinique du sommeil ou à un professionnel le plus tôt possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda buscar una evaluación de una clínica del sueño o un profesional lo antes posible."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "建議儘早向睡眠門診或專業人員尋求評估。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능한 한 빨리 수면 클리닉이나 전문가에게 평가를 받는 것이 좋습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوصى بطلب التقييم من عيادة النوم أو أخصائي في أقرب وقت ممكن."
          }
        }
      }
    },
    "授权失败": {
