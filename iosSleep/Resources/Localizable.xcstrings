    "《“人性恶”不一定只属于别人》王蒙": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《“人性恶”不一定只属于别人》王蒙"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\"Evil human nature\" does not necessarily belong only to others\" Wang Meng"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「『人間の邪悪な本性』は必ずしも他者だけに属するものではない」 王蒙"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Die „böse menschliche Natur“ gehört nicht unbedingt nur anderen“ Wang Meng"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"La nature humaine mauvaise n'appartient pas nécessairement uniquement aux autres\" Wang Meng"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"La \"malvada naturaleza humana\" no necesariamente pertenece sólo a los demás\" Wang Meng"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "《「人性惡」不一定只屬於別人》王蒙"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\"사악한 인간 본성\"은 반드시 남에게만 속하는 것은 아니다\" 왕멍"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"\"الطبيعة البشرية الشريرة\" لا تنتمي بالضرورة إلى الآخرين فقط\" وانغ منغ"
          }
        }
      }
    },
