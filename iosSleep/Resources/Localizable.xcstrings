    "今天吃到的第一口热饭，也值得你在心里轻轻记上一笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天吃到的第一口热饭，也值得你在心里轻轻记上一笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first bite of hot rice you eat today is worth a note in your heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日食べる温かいご飯の最初の一口は、あなたの心に少しだけ価値があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Bissen heißen Reis, den Sie heute essen, ist eine Erinnerung in Ihrem Herzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première bouchée de riz chaud que vous mangez aujourd’hui vaut une note dans votre cœur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer bocado de arroz caliente que comas hoy merece una nota en tu corazón."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "今天吃到的第一口熱飯，也值得你在心裡輕輕記上一筆。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 먹는 첫 밥의 첫 밥은 마음에 새길 만한 가치가 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن اللقمة الأولى من الأرز الساخن التي تتناولها اليوم تستحق ملاحظة في قلبك."
          }
        }
      }
    },
