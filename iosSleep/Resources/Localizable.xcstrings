            "value": "Sehen Sie sich diesen Tag an"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir cette journée"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver este día"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "查看這一天"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 보기"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد هذا اليوم"
          }
        }
      }
    },
    "烦躁的时候，先听听身体在说什么。也许它只是想离开喧闹一会儿。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烦躁的时候，先听听身体在说什么。也许它只是想离开喧闹一会儿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you feel irritable, first listen to what your body is saying. Maybe it just wants to get away from the hustle and bustle for a while."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イライラしたときは、まず自分の体の声に耳を傾けてください。もしかしたら、喧騒から少し離れたいだけなのかもしれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie sich gereizt fühlen, hören Sie zunächst auf die Signale Ihres Körpers. Vielleicht möchte es einfach nur für eine Weile dem Trubel entfliehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous vous sentez irritable, écoutez d’abord ce que dit votre corps. Peut-être qu'il veut juste s'éloigner de l'agitation pendant un moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando te sientas irritable, primero escucha lo que dice tu cuerpo. Tal vez sólo quiera alejarse del ajetreo y el bullicio por un tiempo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "煩躁的時候，先聽聽身體在說什麼。也許它只是想離開喧鬧一會兒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짜증이 날 때는 먼저 몸이 말하는 것을 들어보세요. 어쩌면 잠시나마 번잡함에서 벗어나고 싶을 수도 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما تشعر بالغضب، استمع أولاً إلى ما يقوله جسدك. ربما يريد فقط الابتعاد عن الزحام والضجيج لفترة من الوقت."
          }
        }
      }
    },
    "安静、不被打扰的环境更容易让我进入状态": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静、不被打扰的环境更容易让我进入状态"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet, undisturbed environment makes it easier for me to enter the state of mind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かで誰にも邪魔されない環境は、精神状態に入りやすくします"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ruhige, ungestörte Umgebung erleichtert es mir, in den Geisteszustand zu gelangen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un environnement calme et tranquille me permet d'entrer plus facilement dans l'état d'esprit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ambiente tranquilo y sin perturbaciones me facilita entrar en el estado de ánimo"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "安靜、不被打擾的環境更容易讓我進入狀態"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용하고 방해받지 않는 환경은 내가 마음의 상태에 들어가기 더 쉽게 만듭니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن البيئة الهادئة وغير المضطربة تجعل من السهل علي الدخول في الحالة الذهنية"
          }
        }
      }
    },
    "焦虑感较明显": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "焦虑感较明显"
