        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい知識やさまざまな視点を探求するのが好きです"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich mag es, neues Wissen und andere Perspektiven zu erkunden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'aime explorer de nouvelles connaissances et différentes perspectives"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me gusta explorar nuevos conocimientos y diferentes perspectivas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我喜歡探索新知識和不同觀點"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 새로운 지식과 다양한 관점을 탐구하는 것을 좋아합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحب استكشاف المعرفة الجديدة ووجهات النظر المختلفة"
          }
        }
      }
    },
    "你热情开放，容易感受到当下的乐趣和他人的状态，也愿意把活力带进关系与生活。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你热情开放，容易感受到当下的乐趣和他人的状态，也愿意把活力带进关系与生活。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are enthusiastic and open, easily feel the fun of the moment and the status of others, and are willing to bring vitality into relationships and life."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは情熱的でオープンで、その瞬間の楽しさや他人の状況を簡単に感じ取り、人間関係や人生に活力をもたらすことに積極的です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind enthusiastisch und offen, spüren leicht den Spaß des Augenblicks und den Status anderer und sind bereit, Lebendigkeit in Beziehungen und Leben zu bringen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes enthousiaste et ouvert, ressentez facilement le plaisir du moment et le statut des autres et êtes prêt à apporter de la vitalité aux relations et à la vie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres entusiasta y abierto, sientes fácilmente la diversión del momento y el estatus de los demás y estás dispuesto a aportar vitalidad a las relaciones y a la vida."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你熱情開放，容易感受到當下的樂趣和他人的狀態，也願意把活力帶進關係與生活。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 열정적이고 개방적이며 순간의 재미와 다른 사람의 지위를 쉽게 느끼고 관계와 삶에 활력을 불어넣고 싶어합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت متحمس ومنفتح، وتشعر بسهولة بمتعة اللحظة ومكانة الآخرين، وعلى استعداد لإضفاء الحيوية على العلاقات والحياة."
          }
        }
      }
    },
