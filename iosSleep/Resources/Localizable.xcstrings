    "我习惯提前安排并按计划完成事情": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我习惯提前安排并按计划完成事情"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am used to arranging things in advance and completing things as planned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は物事を事前に手配し、計画通りに完了することに慣れています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin es gewohnt, Dinge im Voraus zu regeln und sie wie geplant abzuschließen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai l'habitude d'organiser les choses à l'avance et de les terminer comme prévu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy acostumbrado a organizar las cosas con anticipación y completarlas según lo planeado."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我習慣提前安排並按計劃完成事情"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 일을 미리 정리하고 계획대로 완료하는 데 익숙하다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا معتاد على ترتيب الأمور مسبقًا وإكمال الأمور كما هو مخطط لها"
          }
        }
      }
    },
    "我会根据对方的状态调整表达方式和语气": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我会根据对方的状态调整表达方式和语气"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I will adjust my expression and tone according to the other person’s status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手の状況に応じて表情や口調を調整します"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich werde meinen Gesichtsausdruck und meinen Ton an den Status der anderen Person anpassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ajusterai mon expression et mon ton en fonction du statut de l'autre personne"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustaré mi expresión y tono según el estado de la otra persona."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我會根據對方的狀態調整表達方式和語氣"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방의 상태에 따라 나의 표정과 말투를 조절해보겠습니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سأقوم بتعديل تعبيراتي ونبرة صوتي وفقًا لحالة الشخص الآخر"
          }
        }
      }
    },
