    "再等我四年，我回来娶你": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再等我四年，我回来娶你"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for me for another four years and I will come back to marry you"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと4年待ってくれたら、結婚するために戻ってくるよ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte noch vier Jahre auf mich und ich werde zurückkommen, um dich zu heiraten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attends-moi encore quatre ans et je reviendrai pour t'épouser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espérame otros cuatro años y volveré para casarme contigo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "再等我四年，我回來娶你"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4년만 더 기다려주세요. 그러면 나는 당신과 결혼하기 위해 다시 돌아올 것입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظرني أربع سنوات أخرى وسأعود لأتزوجك"
          }
        }
      }
    },
