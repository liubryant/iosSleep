    "相比认识很多人，我更看重少数深入的关系": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相比认识很多人，我更看重少数深入的关系"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I value a few deep relationships more than knowing many people"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私は多くの人と知り合いになるよりも、少数の深い関係を大切にします"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich schätze ein paar tiefe Beziehungen mehr, als viele Menschen zu kennen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accorde plus d'importance à quelques relations profondes qu'à la connaissance de nombreuses personnes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valoro más algunas relaciones profundas que conocer a muchas personas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "比起認識很多人，我更重視少數深入的關係"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
