        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏喜歡的聲音後會顯示在這裡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좋아하는 소리를 모아 여기에 표시됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم عرض جمع الأصوات المفضلة لديك هنا."
          }
        }
      }
    },
    "适合有创造空间、节奏灵活且能看见真实影响的环境。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合有创造空间、节奏灵活且能看见真实影响的环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal for an environment where there is room for creativity, a flexible pace, and where real impact can be seen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "創造性の余地があり、柔軟なペースで、実際の効果が見られる環境に最適です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal für ein Umfeld, in dem es Raum für Kreativität, ein flexibles Tempo und echte Wirkung gibt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour un environnement où il y a de la place pour la créativité, un rythme flexible et où un réel impact est visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para un entorno donde hay espacio para la creatividad, un ritmo flexible y donde se puede ver el impacto real."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適合有創造空間、節奏靈活且能看見真實影響的環境。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창의성을 발휘할 여지가 있고 유연한 속도가 있으며 실제 영향을 볼 수 있는 환경에 이상적입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثالية لبيئة يوجد فيها مجال للإبداع، ووتيرة مرنة، وحيث يمكن رؤية التأثير الحقيقي."
          }
        }
      }
    },
    "轻度负荷": {
      "localizations": {
