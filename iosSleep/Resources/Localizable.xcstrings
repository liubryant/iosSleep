    "请根据最近 2 周的真实感受作答": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据最近 2 周的真实感受作答"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please answer based on your true feelings in the past 2 weeks"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去 2 週間のあなたの本当の気持ちに基づいて答えてください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte antworten Sie auf der Grundlage Ihrer wahren Gefühle in den letzten 2 Wochen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez répondre en fonction de vos véritables sentiments au cours des 2 dernières semaines"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda según sus verdaderos sentimientos en las últimas 2 semanas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請根據最近 2 週的真實感受作答"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
