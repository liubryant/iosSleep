          }
        }
      }
    },
    "你敏捷好奇，喜欢挑战默认答案，并通过观点碰撞发现更有趣、更有效的可能。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你敏捷好奇，喜欢挑战默认答案，并通过观点碰撞发现更有趣、更有效的可能。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are agile and curious, and like to challenge default answers and discover more interesting and effective possibilities through the collision of perspectives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは機敏で好奇心旺盛で、デフォルトの答えに挑戦し、視点の衝突を通じてより興味深く効果的な可能性を発見することを好みます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind agil und neugierig und stellen gerne Standardantworten in Frage und entdecken durch die Kollision verschiedener Perspektiven interessantere und effektivere Möglichkeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes agile et curieux, et aimez remettre en question les réponses par défaut et découvrir des possibilités plus intéressantes et efficaces grâce à la collision des perspectives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres ágil y curioso, y te gusta desafiar las respuestas predeterminadas y descubrir posibilidades más interesantes y efectivas a través de la colisión de perspectivas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你敏捷好奇，喜歡挑戰預設答案，並透過觀點碰撞發現更有趣、更有效的可能性。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 민첩하고 호기심이 많으며 기본 답변에 도전하고 관점의 충돌을 통해 더 흥미롭고 효과적인 가능성을 발견하는 것을 좋아합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت رشيق وفضولي، وترغب في تحدي الإجابات الافتراضية واكتشاف إمكانيات أكثر إثارة للاهتمام وفعالية من خلال تصادم وجهات النظر."
          }
        }
      }
    },
    "走神了，也完全没关系": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走神了，也完全没关系"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It doesn't matter if you get distracted"
          }
