            "value": "savait"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sabía"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알고 있었다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرف"
          }
        }
      }
    },
    "偶尔说一句「我还没想好」，就能给心里的感受留出一点空地。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偶尔说一句「我还没想好」，就能给心里的感受留出一点空地。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Occasionally saying \"I haven't thought about it yet\" can leave a little space for the feelings in the heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時々「まだ考えていない」と言うと、心の中に感情のためのスペースが少し残ることがあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelegentlich zu sagen: „Ich habe noch nicht darüber nachgedacht“, kann ein wenig Raum für die Gefühle im Herzen lassen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dire occasionnellement « Je n’y ai pas encore pensé » peut laisser un peu de place aux sentiments dans le cœur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando decir \"No he pensado en eso todavía\" puede dejar un poco de espacio para los sentimientos en el corazón."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "偶爾說一句「我還沒想好」，就能給心裡的感受留一點空地。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 \"아직 생각해본 적 없어\"라고 말하는 것만으로도 마음속에 감정을 표현할 수 있는 여지가 조금 남을 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحيانًا قد يؤدي قول \"لم أفكر في الأمر بعد\" إلى ترك مساحة صغيرة للمشاعر في القلب."
          }
        }
      }
    },
    "明天的事可以先留在纸上。今晚只需要把这一口气慢慢呼完。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天的事可以先留在纸上。今晚只需要把这一口气慢慢呼完。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow's affairs can be left on paper for now. Just take this breath out slowly tonight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日のことは今のところ紙に残しておくことができます。今夜はゆっくりと息を吐き出してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angelegenheiten von morgen können vorerst auf dem Papier belassen werden. Atme heute Abend einfach langsam aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les affaires de demain peuvent être laissées sur papier pour le moment. Expirez lentement ce soir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los asuntos del mañana pueden dejarse en el papel por ahora. Simplemente exhale lentamente esta noche."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "明天的事可以先留在紙上。今晚只需要把這一口氣慢慢呼完。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일의 일은 지금은 종이에 남겨 둘 수 있습니다. 오늘 밤에는 천천히 숨을 내쉬세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن ترك شؤون الغد على الورق في الوقت الحالي. فقط خذ هذا النفس ببطء هذه الليلة."
          }
        }
      }
    },
    "与他人相处会让我感到有活力": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与他人相处会让我感到有活力"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Being around others makes me feel alive"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人と一緒にいると生きている実感が得られる"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich mit anderen zusammen bin, fühle ich mich lebendig"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être avec les autres me fait me sentir vivant"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estar rodeado de otras personas me hace sentir vivo"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "與他人相處會讓我感到有活力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람들과 함께 있으면 내가 살아있음을 느끼게 된다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواجد حول الآخرين يجعلني أشعر أنني على قيد الحياة"
          }
        }
      }
    },
    "根据当天精神高峰安排高难度任务。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据当天精神高峰安排高难度任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrange difficult tasks according to the mental peak of the day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その日の精神的なピークに合わせて、難しいタスクを調整します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie schwierige Aufgaben entsprechend dem mentalen Höhepunkt des Tages an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez les tâches difficiles en fonction du pic mental de la journée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organice las tareas difíciles según el pico mental del día."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "依照當天精神高峰安排高難度任務。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그날의 정신적 정점에 따라 어려운 작업을 준비하십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب المهام الصعبة وفقا للذروة العقلية لليوم."
          }
        }
      }
    },
    "有可观察的证据时，我才更愿意相信一个判断": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有可观察的证据时，我才更愿意相信一个判断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am more willing to trust a judgment when there is observable evidence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観察可能な証拠がある場合、私は判決をより信頼するようになります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin eher bereit, einem Urteil zu vertrauen, wenn es beobachtbare Beweise gibt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis plus disposé à faire confiance à un jugement lorsqu'il existe des preuves observables"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy más dispuesto a confiar en un juicio cuando hay evidencia observable."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有可觀察的證據時，我才更願意相信一個判斷"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 관찰 가능한 증거가 있을 때 판결을 더 신뢰하고자 한다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا أكثر استعدادًا للثقة في الحكم عندما يكون هناك دليل يمكن ملاحظته"
          }
        }
      }
    },
    "正念，是温柔地回到此刻": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正念，是温柔地回到此刻"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness is returning to the present moment gently"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マインドフルネスは今この瞬間にそっと戻ってくる"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtsamkeit bedeutet, sanft in den gegenwärtigen Moment zurückzukehren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pleine conscience revient au moment présent en douceur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindfulness es volver suavemente al momento presente"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正念，是溫柔地回到此刻"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음챙김은 현재 순간으로 부드럽게 돌아오는 것입니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليقظه يعود إلى اللحظة الحالية بلطف"
          }
        }
      }
    },
    "河": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "河"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "river"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "川"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluss"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "rivière"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "río"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "河"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نهر"
          }
        }
      }
    },
    "创意丰富、善于鼓舞他人，能快速看见新的方向和潜力。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创意丰富、善于鼓舞他人，能快速看见新的方向和潜力。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich in creativity, good at inspiring others, and able to quickly see new directions and potential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "創造力に富み、他人にインスピレーションを与えるのが得意で、新しい方向性や可能性をすぐに見つけることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reich an Kreativität, gut darin, andere zu inspirieren und in der Lage, schnell neue Richtungen und Potenziale zu erkennen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riche en créativité, doué pour inspirer les autres et capable de voir rapidement de nouvelles directions et de nouveaux potentiels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rico en creatividad, bueno para inspirar a otros y capaz de ver rápidamente nuevas direcciones y potenciales."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "創意豐富、善於鼓舞他人，能快速看見新的方向與潛能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창의력이 풍부하고 다른 사람에게 영감을 주는 데 능숙하며 새로운 방향과 잠재력을 빠르게 발견할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غني بالإبداع، وجيد في إلهام الآخرين، وقادر على رؤية الاتجاهات والإمكانات الجديدة بسرعة."
          }
        }
      }
    },
    "路上遇到一只专心晒太阳的猫。你也可以在有阳光的地方站一会儿。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路上遇到一只专心晒太阳的猫。你也可以在有阳光的地方站一会儿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I met a cat basking in the sun on the road. You can also stand in a sunny place for a while."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道路で日向ぼっこをしている猫に出会いました。日当たりの良い場所にしばらく置いておくこともできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf der Straße traf ich eine Katze, die sich in der Sonne sonnte. Sie können auch eine Weile an einem sonnigen Ort stehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai rencontré un chat se prélassant au soleil sur la route. Vous pouvez également rester un moment dans un endroit ensoleillé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Me encontré con un gato tomando el sol en el camino. También puedes permanecer un rato en un lugar soleado."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "路上遇到一隻專心曬太陽的貓。你也可以在有陽光的地方站一會兒。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길에서 햇빛을 쬐고 있는 고양이를 만났습니다. 잠시 동안 햇볕이 잘 드는 곳에 서 있을 수도 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقيت بقطة تتشمس على الطريق. يمكنك أيضًا الوقوف في مكان مشمس لفترة من الوقت."
          }
        }
      }
    },
    "一件小事也可能让人难过。给自己一点时间，感受不必按大小排队。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一件小事也可能让人难过。给自己一点时间，感受不必按大小排队。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even a small thing can make someone sad. Give yourself some time to feel like you don’t have to line up by size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほんの些細なことでも誰かを悲しませることがあります。サイズごとに並ぶ必要がないと感じるまで、少し時間をとってください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon eine kleine Sache kann jemanden traurig machen. Nehmen Sie sich etwas Zeit, um das Gefühl zu haben, dass Sie sich nicht nach Größe ordnen müssen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même une petite chose peut rendre quelqu’un triste. Donnez-vous le temps de sentir que vous n’avez pas à vous aligner par taille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluso una pequeña cosa puede entristecer a alguien. Tómese un tiempo para sentir que no tiene que alinearse por tamaño."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "一件小事也可能讓人難過。給自己一點時間，感受不必以大小排隊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 일이라도 누군가를 슬프게 할 수 있습니다. 사이즈별로 줄을 설 필요가 없다는 느낌을 받을 시간을 가져보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حتى الشيء الصغير يمكن أن يجعل شخص ما حزينا. امنح نفسك بعض الوقت لتشعر أنك لست مضطرًا إلى الاصطفاف حسب الحجم."
          }
        }
      }
    },
    "结果仅供自我观察，不用于疾病诊断。感受持续或明显影响生活时，请联系有资质的专业人员。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果仅供自我观察，不用于疾病诊断。感受持续或明显影响生活时，请联系有资质的专业人员。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The results are for self-observation only and are not used for disease diagnosis. If you experience persistent or significant impact on your life, please contact a qualified professional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は自己観察のみを目的としており、病気の診断には使用されません。生活に持続的または重大な影響が生じた場合は、資格のある専門家にご相談ください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse dienen ausschließlich der Selbstbeobachtung und werden nicht zur Krankheitsdiagnose verwendet. Wenn Sie anhaltende oder erhebliche Auswirkungen auf Ihr Leben verspüren, wenden Sie sich bitte an einen qualifizierten Fachmann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats sont uniquement destinés à l’auto-observation et ne sont pas utilisés pour le diagnostic de la maladie. Si vous ressentez un impact persistant ou important sur votre vie, veuillez contacter un professionnel qualifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados son únicamente para autoobservación y no se utilizan para el diagnóstico de enfermedades. Si experimenta un impacto persistente o significativo en su vida, comuníquese con un profesional calificado."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "結果僅供自我觀察，不用於疾病診斷。感受持續或明顯影響生活時，請聯絡有資格的專業人員。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과는 자가 관찰용일 뿐 질병 진단에 사용되지 않습니다. 귀하의 삶에 지속적이거나 중대한 영향을 미치는 경우 자격을 갖춘 전문가에게 문의하십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتائج مخصصة للمراقبة الذاتية فقط ولا تستخدم لتشخيص المرض. إذا واجهت تأثيرًا مستمرًا أو كبيرًا على حياتك، فيرجى الاتصال بمتخصص مؤهل."
          }
        }
      }
    },
