    "比吸气更慢一点，把紧绷轻轻放下": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比吸气更慢一点，把紧绷轻轻放下"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe in more slowly and gently let go of the tension"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もっとゆっくりと息を吸いながら、ゆっくりと緊張をほぐしてください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Atmen Sie langsamer ein und lassen Sie die Anspannung sanft los"
