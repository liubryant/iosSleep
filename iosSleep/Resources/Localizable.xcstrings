    "rachel安定身心助眠": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "rachel安定身心助眠"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "rachel calms the mind and body and helps sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイチェルは心と体を落ち着かせ、眠りを助けます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rachel beruhigt Geist und Körper und hilft beim Schlafen"
          }
        },
        "fr": {
