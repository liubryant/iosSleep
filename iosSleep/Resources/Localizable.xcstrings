    "我容易因小事变得焦虑或不安": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我容易因小事变得焦虑或不安"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I tend to become anxious or upset over small things"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "些細なことで不安になったり動揺したりする傾向がある"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich neige dazu, über kleine Dinge ängstlich oder verärgert zu werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai tendance à devenir anxieux ou bouleversé à cause de petites choses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiendo a sentirme ansioso o molesto por cosas pequeñas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我容易因小事變得焦慮或不安"
          }
