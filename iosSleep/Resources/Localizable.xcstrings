    "平静思绪，更快进入睡眠": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平静思绪，更快进入睡眠"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calm your thoughts and fall asleep faster"
          }
        },
        "ja": {
