          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストは失敗しました。後でもう一度試してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage ist fehlgeschlagen. Bitte versuchen Sie es später noch einmal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande a échoué, veuillez réessayer plus tard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud falló. Vuelve a intentarlo más tarde."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請求失敗，請稍後重試"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 실패했습니다. 나중에 다시 시도해 주세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الطلب، يرجى المحاولة مرة أخرى في وقت لاحق"
          }
        }
      }
    },
    "知道了": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知道了"
          }
        },
        "en": {
