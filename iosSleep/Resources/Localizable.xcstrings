    "该哭不哭，身体受苦": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该哭不哭，身体受苦"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should you cry or not? Your body will suffer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "泣いたほうがいいのか、泣かないほうがいいのか？あなたの体は苦しむでしょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll man weinen oder nicht? Dein Körper wird leiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faut-il pleurer ou pas ? Votre corps va souffrir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deberías llorar o no? Tu cuerpo sufrirá."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "該哭不哭，身體受苦"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "울어야 하나 말아야 하나? 당신의 몸은 고통받을 것입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يجب أن تبكي أم لا؟ سوف يعاني جسمك."
          }
        }
      }
    },
