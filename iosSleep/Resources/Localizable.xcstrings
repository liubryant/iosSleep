          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There have been some recent stress reactions that require a more proactive approach to recovery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近、回復のためにより積極的なアプローチが必要なストレス反応がいくつかあります。"
