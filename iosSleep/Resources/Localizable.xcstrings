      }
    },
    "把重要任务安排在上午。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把重要任务安排在上午。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedule important tasks in the morning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要なタスクは午前中にスケジュールを立てます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen Sie wichtige Aufgaben für den Morgen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez les tâches importantes le matin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programe tareas importantes por la mañana."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把重要任務安排在上午。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침에 중요한 작업을 계획하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جدولة المهام الهامة في الصباح."
          }
        }
      }
    },
    "从身体紧绷、思绪负担和恢复能力三个方面，了解当前压力状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从身体紧绷、思绪负担和恢复能力三个方面，了解当前压力状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand the current state of stress from three aspects: physical tension, mental burden, and recovery ability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身体的緊張、精神的負担、回復力の3つの側面からストレスの現状を把握します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstehen Sie den aktuellen Stresszustand unter drei Aspekten: körperliche Anspannung, psychische Belastung und Erholungsfähigkeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprenez l’état de stress actuel sous trois aspects : la tension physique, la charge mentale et la capacité de récupération."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprender el estado actual de estrés desde tres aspectos: tensión física, carga mental y capacidad de recuperación."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從身體緊繃、思緒負擔和恢復能力三個方面，了解當前壓力狀態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신체적 긴장, 정신적 부담, 회복능력의 세 가지 측면에서 현재의 스트레스 상태를 이해합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فهم حالة التوتر الحالية من ثلاثة جوانب: التوتر الجسدي، والعبء العقلي، والقدرة على التعافي."
          }
        }
      }
    },
    "关注连续忙碌后的恢复时间。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注连续忙碌后的恢复时间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay attention to recovery time after a busy period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繁忙期の後の回復時間に注意してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achten Sie auf die Erholungszeit nach einer arbeitsreichen Zeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites attention au temps de récupération après une période chargée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preste atención al tiempo de recuperación después de un período de mucha actividad."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "注意連續忙碌後的恢復時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바쁜 시간을 보낸 후 회복 시간에주의하십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتبه إلى وقت التعافي بعد فترة مزدحمة."
          }
        }
      }
    },
    "辩论不一定是冲突，但需要确认对方此刻想讨论还是想被理解。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辩论不一定是冲突，但需要确认对方此刻想讨论还是想被理解。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A debate is not necessarily a conflict, but it does require acknowledgment that the other person wants to discuss or be understood at the moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "議論は必ずしも衝突ではありませんが、相手が現時点で議論したい、または理解してもらいたいと望んでいることを認識する必要があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Debatte ist nicht unbedingt ein Konflikt, aber sie erfordert die Anerkennung, dass die andere Person gerade diskutieren oder verstanden werden möchte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un débat n’est pas nécessairement un conflit, mais il nécessite de reconnaître que l’autre personne veut discuter ou être comprise sur le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un debate no es necesariamente un conflicto, pero sí requiere el reconocimiento de que la otra persona quiere discutir o ser comprendida en ese momento."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "辯論不一定是衝突，但需要確認對方此刻想討論還是想被理解。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토론이 반드시 갈등일 필요는 없지만, 상대방이 현재 토론하고 싶어하거나 이해받고 싶어 한다는 점을 인정해야 합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يعد النقاش بالضرورة صراعًا، ولكنه يتطلب الاعتراف بأن الشخص الآخر يريد أن يناقش أو يفهم في الوقت الحالي."
          }
        }
      }
    },
