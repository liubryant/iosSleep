          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhige deine Gedanken und schlafe schneller ein"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmez vos pensées et endormez-vous plus vite"
          }
        },
        "es": {
