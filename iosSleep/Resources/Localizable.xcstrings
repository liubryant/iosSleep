    "进入陌生群体时，我常会主动开启话题": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入陌生群体时，我常会主动开启话题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When entering a group of strangers, I often take the initiative to start a conversation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見知らぬ人のグループに入ると、私は率先して会話を始めることがよくあります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich in eine Gruppe von Fremden komme, ergreife ich oft die Initiative und beginne ein Gespräch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque j'entre dans un groupe d'inconnus, je prends souvent l'initiative d'entamer une conversation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando entro en un grupo de extraños, a menudo tomo la iniciativa de iniciar una conversación."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "進入陌生群時，我常會主動開啟話題"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낯선 사람들 사이에 들어갈 때 나는 종종 주도적으로 대화를 시작한다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الدخول إلى مجموعة من الغرباء، غالبًا ما أبادر ببدء محادثة"
          }
        }
      }
    },
    "适合高挑战、可承担责任并影响系统方向的环境。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合高挑战、可承担责任并影响系统方向的环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suitable for an environment of high challenge, taking responsibility and influencing the direction of the system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "責任を持ち、システムの方向性に影響を与える、挑戦の多い環境に適しています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeignet für ein Umfeld mit hohen Herausforderungen, in dem Verantwortung übernommen und die Richtung des Systems beeinflusst wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convient à un environnement à haut défi, assumant des responsabilités et influençant l’orientation du système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adecuado para un entorno de alto desafío, asumiendo responsabilidad e influyendo en la dirección del sistema."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適合高挑戰、可承擔責任並影響系統方向的環境。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책임을 지고 시스템 방향에 영향을 미치면서 도전적인 환경에 적합합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناسبة لبيئة عالية التحدي وتحمل المسؤولية والتأثير على اتجاه النظام."
          }
        }
      }
    },
    "我愿意主动认识新朋友": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我愿意主动认识新朋友"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am willing to take the initiative to meet new friends"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい友達に会うために率先して進んでいきます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin bereit, die Initiative zu ergreifen, um neue Freunde kennenzulernen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis prêt à prendre l'initiative de rencontrer de nouveaux amis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy dispuesto a tomar la iniciativa para conocer nuevos amigos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我願意主動認識新朋友"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나는 새로운 친구를 만나기 위해 주도권을 잡을 의향이 있습니다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا على استعداد لأخذ زمام المبادرة للقاء أصدقاء جدد"
          }
        }
      }
    },
    "授权后读取睡眠阶段、睡眠心率、HRV、呼吸频率和血氧等数据。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后读取睡眠阶段、睡眠心率、HRV、呼吸频率和血氧等数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After authorization, read data such as sleep stages, sleep heart rate, HRV, respiratory rate, and blood oxygen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証後、睡眠段階、睡眠時心拍数、HRV、呼吸数、血中酸素などのデータを読み取ります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen Sie nach der Autorisierung Daten wie Schlafstadien, Schlafherzfrequenz, HRV, Atemfrequenz und Blutsauerstoff ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après autorisation, lisez les données telles que les phases de sommeil, la fréquence cardiaque du sommeil, le VRC, la fréquence respiratoire et l'oxygène dans le sang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la autorización, lea datos como las etapas del sueño, la frecuencia cardíaca durante el sueño, la VFC, la frecuencia respiratoria y el oxígeno en sangre."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "授權後讀取睡眠階段、睡眠心率、HRV、呼吸頻率和血氧等數據。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 후 수면 단계, 수면 심박수, HRV, 호흡수, 혈중 산소 등의 데이터를 읽습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الحصول على إذن، قم بقراءة البيانات مثل مراحل النوم ومعدل ضربات القلب أثناء النوم ومعدل ضربات القلب ومعدل التنفس والأكسجين في الدم."
          }
        }
      }
    },
