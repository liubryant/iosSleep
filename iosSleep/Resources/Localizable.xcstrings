          "stringUnit": {
            "state": "translated",
            "value": "完成一次睡眠监测后，这里会显示周/月趋势。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After completing a sleep monitoring session, the weekly/monthly trend will be displayed here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠モニタリングセッションが完了すると、週次/月次の傾向がここに表示されます。"
