    "只要规则公平，我能接受一个让人不舒服的结论": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要规则公平，我能接受一个让人不舒服的结论"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as the rules are fair, I can accept an uncomfortable conclusion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールが公平である限り、不快な結論を受け入れることができます"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Regeln fair sind, kann ich eine unangenehme Schlussfolgerung akzeptieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que les règles sont équitables, je peux accepter une conclusion inconfortable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras las reglas sean justas, puedo aceptar una conclusión incómoda."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只要規則公平，我能接受一個讓人不舒服的結論"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙이 공정하다면 불편한 결론도 받아들일 수 있다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وطالما أن القواعد عادلة، فيمكنني قبول نتيجة غير مريحة"
          }
        }
      }
    },
