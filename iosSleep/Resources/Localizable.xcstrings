    "脑中有很多事情，很难真正安静下来": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脑中有很多事情，很难真正安静下来"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are so many things on my mind that it’s hard to really calm down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いろいろなことを考えすぎて、なかなか落ち着くことができない"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir gehen so viele Dinge durch den Kopf, dass es schwer ist, wirklich zur Ruhe zu kommen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'ai tellement de choses en tête que c'est difficile de vraiment me calmer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay tantas cosas en mi mente que es difícil realmente calmarme."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "腦中有很多事情，很難真正安靜下來"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음속에 생각이 너무 많아서 진정하기가 힘들어요"
