    "如果自由安排，重要工作会放在什么时间": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果自由安排，重要工作会放在什么时间"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can arrange it freely, when will important work be done?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自由にアレンジできるとしたら、重要な作業はいつ行われますか?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie es frei gestalten können, wann werden wichtige Arbeiten erledigt?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous pouvez l’organiser librement, quand les travaux importants seront-ils effectués ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si puede organizarlo libremente, ¿cuándo se realizará un trabajo importante?"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
