        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiple sleep experiences are affecting recovery. It is recommended to proactively adjust and continue to observe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の睡眠経験が回復に影響を及ぼします。積極的に調整し、観察を続けることをお勧めします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Schlaferlebnisse beeinträchtigen die Genesung. Es empfiehlt sich, proaktiv anzupassen und weiter zu beobachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De multiples expériences de sommeil affectent la récupération. Il est recommandé de s’ajuster de manière proactive et de continuer à observer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Múltiples experiencias de sueño están afectando la recuperación. Se recomienda ajustar proactivamente y continuar observando."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "多項睡眠體驗正在影響恢復，建議主動調整並持續觀察。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 번의 수면 경험이 회복에 영향을 미칩니다. 적극적으로 조정하고 계속 관찰하는 것이 좋습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجارب النوم المتعددة تؤثر على التعافي. يوصى بالتعديل بشكل استباقي ومواصلة المراقبة."
          }
        }
      }
    },
