    "开始后会在本地识别打鼾、咳嗽、梦话、磨牙和噪音": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始后会在本地识别打鼾、咳嗽、梦话、磨牙和噪音"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snoring, coughing, sleep talking, teeth grinding and noises are recognized locally when started"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時にいびき、咳、寝言、歯ぎしり、騒音が局所的に認識される"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnarchen, Husten, Schlafgespräche, Zähneknirschen und Geräusche werden bei Beginn lokal erkannt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ronflements, la toux, les conversations endormies, les grincements de dents et les bruits sont reconnus localement au démarrage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ronquidos, la tos, el hablar dormido, el rechinar de dientes y los ruidos se reconocen localmente cuando se inician."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始後會在本地辨識打鼾、咳嗽、夢話、磨牙和噪音"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코골이, 기침, 잠꼬대, 이갈이, 소음 등은 시작 시 국소적으로 인식됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم التعرف على الشخير والسعال والحديث أثناء النوم وصرير الأسنان والضوضاء محليًا عند البدء"
          }
        }
      }
    },
