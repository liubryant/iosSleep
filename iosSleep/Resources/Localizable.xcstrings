            "state": "translated",
            "value": "Calma tus pensamientos y concilia el sueño más rápido"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "平靜思緒，更快進入睡眠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각을 진정시키고 더 빨리 잠들다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تهدئة أفكارك وتغفو بشكل أسرع"
          }
        }
      }
    },
    "试试更短的关键词，比如「雨」或「海浪」。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试更短的关键词，比如「雨」或「海浪」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try shorter keywords like \"rain\" or \"waves.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「雨」や「波」などの短いキーワードを試してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit kürzeren Schlüsselwörtern wie „Regen“ oder „Wellen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez des mots clés plus courts comme « pluie » ou « vagues »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe con palabras clave más cortas como \"lluvia\" u \"olas\"."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "試試更短的關鍵字，例如“雨”或“海浪”。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'비' 또는 '파도'와 같은 더 짧은 키워드를 사용해 보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب كلمات رئيسية أقصر مثل \"أمطار\" أو \"أمواج\"."
          }
        }
      }
    },
    "与信任的人谈谈近期状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与信任的人谈谈近期状态。"
