    "把他人的选择还给他人，避免为所有人的结果承担责任。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把他人的选择还给他人，避免为所有人的结果承担责任。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give back the choices of others and avoid taking responsibility for everyone's outcomes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人の選択を尊重し、全員の結果に対して責任を負わないようにします。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Entscheidungen anderer zurück und vermeiden Sie es, die Verantwortung für die Ergebnisse aller zu übernehmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redonnez aux autres les choix et évitez d’assumer la responsabilité des résultats de chacun."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Devolver las opciones de los demás y evitar asumir la responsabilidad de los resultados de todos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把他人的選擇還給他人，避免為所有人的結果負責。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 선택을 돌려주고 모든 사람의 결과에 대해 책임을 지지 마십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رد خيارات الآخرين وتجنب تحمل المسؤولية عن نتائج الجميع."
          }
        }
      }
    },
