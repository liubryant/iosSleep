          }
        }
      }
    },
    "优先通过厂商 App 与 Apple 健康同步，无需把账号密码交给时光睡眠。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先通过厂商 App 与 Apple 健康同步，无需把账号密码交给时光睡眠。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritize synchronizing with Apple Health through the manufacturer's App, without giving your account and password to Time Sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Sleep にアカウントとパスワードを提供せずに、メーカーのアプリを通じて Apple Health との同期を優先します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisieren Sie die Synchronisierung mit Apple Health über die App des Herstellers, ohne Ihr Konto und Passwort an Time Sleep weiterzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez la priorité à la synchronisation avec Apple Health via l'application du fabricant, sans donner votre compte et votre mot de passe à Time Sleep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriza la sincronización con Apple Health a través de la App del fabricante, sin dar tu cuenta y contraseña a Time Sleep."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "優先透過廠商 App 與 Apple 健康同步，不需把帳號密碼交給時光睡眠。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Time Sleep에 계정과 비밀번호를 제공하지 않고 제조업체의 앱을 통해 Apple Health와 우선적으로 동기화하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإعطاء الأولوية للمزامنة مع Apple Health من خلال تطبيق الشركة المصنعة، دون إعطاء حسابك وكلمة المرور الخاصة بك إلى Time Sleep."
          }
        }
      }
    },
    "清除数据": {
      "localizations": {
