    "与心理或医疗专业人员讨论近期状态。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与心理或医疗专业人员讨论近期状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuss recent status with a psychological or medical professional."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の状況について心理学または医療の専門家に相談してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besprechen Sie den aktuellen Stand mit einem Psychologen oder Mediziner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discutez de votre statut récent avec un professionnel de la psychologie ou de la santé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuta el estado reciente con un profesional médico o psicológico."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "與心理或醫療專業人員討論近期狀態。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "심리학자 또는 의료 전문가와 최근 상태에 대해 논의하십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ناقش الحالة الأخيرة مع أخصائي نفسي أو طبي."
          }
        }
      }
    },
    "临时变化常能激发我随机应变的能力": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时变化常能激发我随机应变的能力"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary changes often stimulate my ability to adapt to changes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的な変化は、変化に適応する能力を刺激することがよくあります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorübergehende Veränderungen stimulieren oft meine Fähigkeit, mich an Veränderungen anzupassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements temporaires stimulent souvent ma capacité à m'adapter aux changements"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios temporales a menudo estimulan mi capacidad de adaptarme a los cambios."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時變化常能激發我隨機應變的能力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적인 변화는 종종 변화에 적응하는 능력을 자극합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالبًا ما تحفز التغييرات المؤقتة قدرتي على التكيف مع التغييرات"
          }
        }
      }
    },
    "近期睡眠困扰较为集中，单靠偶尔补觉可能难以恢复。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期睡眠困扰较为集中，单靠偶尔补觉可能难以恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep problems have become more concentrated recently, and it may be difficult to recover by just catching up on sleep occasionally."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近は睡眠の問題が集中しており、時々睡眠をとるだけでは回復するのが難しい場合があります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafprobleme treten in letzter Zeit häufiger auf und es kann schwierig sein, sich nur durch gelegentliches Nachholen zu erholen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les problèmes de sommeil sont devenus plus concentrés ces derniers temps et il peut être difficile de récupérer en rattrapant simplement son sommeil de temps en temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los problemas del sueño se han vuelto más concentrados recientemente y puede ser difícil recuperarse simplemente recuperando el sueño de vez en cuando."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "近期睡眠困擾較為集中，單靠偶爾補眠可能難以恢復。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 수면 문제가 더욱 집중화되어 가끔씩 잠을 자는 것만으로는 회복하기 어려울 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصبحت مشاكل النوم أكثر تركيزًا في الآونة الأخيرة، وقد يكون من الصعب التعافي بمجرد اللحاق بالنوم من حين لآخر."
          }
        }
      }
    },
    "查看这一天": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看这一天"
          }
        },
        "en": {
