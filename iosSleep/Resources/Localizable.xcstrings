    "继续记录睡眠，观察长期趋势。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续记录睡眠，观察长期趋势。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to log your sleep and observe long-term trends."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠を記録し続け、長期的な傾向を観察してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokollieren Sie weiterhin Ihren Schlaf und beobachten Sie langfristige Trends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à enregistrer votre sommeil et observez les tendances à long terme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúe registrando su sueño y observe las tendencias a largo plazo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續記錄睡眠，觀察長期趨勢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속해서 수면을 기록하고 장기적인 추세를 관찰하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في تسجيل نومك ومراقبة الاتجاهات طويلة المدى."
          }
        }
      }
    },
    "注销失败，请稍后重试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注销失败，请稍后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
