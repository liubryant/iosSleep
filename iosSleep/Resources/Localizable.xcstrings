    "完成后可在获得授权的情况下写入 Apple 健康正念时长": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成后可在获得授权的情况下写入 Apple 健康正念时长"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After completion, Apple Health Mindfulness Duration can be written with authorization."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了後、承認を得て Apple Health Mindful 期間を書き込むことができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss kann die Apple Health Mindfulness Duration mit Genehmigung geschrieben werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois terminé, Apple Health Mindfulness Duration peut être écrit avec autorisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez finalizado, la duración de Apple Health Mindfulness se puede escribir con autorización."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "完成後可在授權的情況下寫入 Apple 健康正念時長"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 후 승인을 받아 Apple 건강 마음챙김 기간을 작성할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الانتهاء، يمكن كتابة مدة اليقظة الذهنية الخاصة بـ Apple Health مع الحصول على إذن."
          }
        }
      }
    },
    "连接指南": {
      "localizations": {
