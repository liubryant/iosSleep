    "体贴、有责任感，能记住细节并持续照顾团队需要。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体贴、有责任感，能记住细节并持续照顾团队需要。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Considerate and responsible, able to remember details and continue to take care of the needs of the team."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いやりがあり、責任感があり、詳細を覚えていて、チームのニーズに配慮し続けることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rücksichtsvoll und verantwortungsbewusst, in der Lage, sich an Details zu erinnern und sich weiterhin um die Bedürfnisse des Teams zu kümmern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réfléchi et responsable, capable de se souvenir des détails et de continuer à répondre aux besoins de l'équipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reflexivo y responsable, capaz de recordar detalles y seguir atendiendo las necesidades del equipo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "體貼、有責任感，能記住細節並持續照顧團隊需求。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사려 깊고 책임감이 있으며 세부 사항을 기억하고 팀의 요구 사항을 지속적으로 처리할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدروس ومسؤول وقادر على تذكر التفاصيل ومواصلة الاهتمام باحتياجات الفريق."
          }
        }
      }
    },
