        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合有意义、能自主创作并允许深度专注的任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal for tasks that are meaningful, create autonomy, and allow for deep focus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意味があり、自主性が生まれ、深い集中力が得られるタスクに最適です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal für Aufgaben, die sinnvoll sind, Autonomie schaffen und eine tiefe Konzentration ermöglichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour les tâches significatives, créant de l’autonomie et permettant une concentration approfondie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para tareas que son significativas, crean autonomía y permiten una concentración profunda."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適合有意義、能自主創作並允許深度專注的任務。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의미 있고 자율성을 창출하며 깊은 집중을 허용하는 작업에 이상적입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثالية للمهام ذات المغزى، وتخلق الاستقلالية، وتسمح بالتركيز العميق."
          }
        }
      }
    },
