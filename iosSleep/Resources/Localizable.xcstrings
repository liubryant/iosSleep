    "记录让自己感到轻松或有意义的小事。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录让自己感到轻松或有意义的小事。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record the little things that make you feel relaxed or meaningful."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リラックスしたり有意義に感じたりする小さなことを記録してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notieren Sie die kleinen Dinge, die Ihnen ein entspanntes oder bedeutungsvolles Gefühl geben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les petites choses qui vous font vous sentir détendu ou significatif."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre las pequeñas cosas que lo hagan sentir relajado o significativo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄讓自己感到輕鬆或有意義的小事。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신을 편안하게 하거나 의미 있게 만드는 작은 것들을 기록해보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الأشياء الصغيرة التي تجعلك تشعر بالاسترخاء أو المعنى."
          }
        }
      }
    },
