          "stringUnit": {
            "state": "translated",
            "value": "• 注销后该手机号可重新注册新账号"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• After logging out, the mobile phone number can be used to register a new account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
