          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تضمين هذا التمرين في مدة اليقظة الذهنية الخاصة بـ Apple Health."
          }
        }
      }
    },
    "晚间减少强光刺激，帮助生物钟逐步前移。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚间减少强光刺激，帮助生物钟逐步前移。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce bright light stimulation at night to help the biological clock gradually move forward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜間の明るい光の刺激を減らし、体内時計を徐々に進めます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzieren Sie die Stimulation durch helles Licht nachts, um die biologische Uhr dabei zu unterstützen, sich allmählich vorwärts zu bewegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez la stimulation par la lumière vive la nuit pour aider l’horloge biologique à avancer progressivement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca la estimulación con luz brillante durante la noche para ayudar a que el reloj biológico avance gradualmente."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "晚間減少強光刺激，幫助生理時鐘逐步前移。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밤에는 밝은 빛 자극을 줄여 생체 시계가 점차 앞으로 나아갈 수 있도록 돕습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلل من تحفيز الضوء الساطع ليلاً لمساعدة الساعة البيولوجية على المضي قدمًا تدريجيًا."
          }
        }
      }
    },
    "✦ 专享内容更新": {
