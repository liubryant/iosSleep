          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapas del sueño, recuperación, frecuencia cardíaca y oxígeno en sangre."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠階段、恢復、心率與血氧"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면 단계, 회복, 심박수 및 혈중 산소"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراحل النوم والشفاء ومعدل ضربات القلب والأكسجين في الدم"
          }
        }
      }
    },
    "睡眠分布": {
