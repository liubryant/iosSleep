    "保持基本作息，不用酒精等方式回避焦虑。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持基本作息，不用酒精等方式回避焦虑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintain a basic routine and avoid using alcohol or other means to avoid anxiety."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的な生活習慣を維持し、不安を避けるためにアルコールやその他の手段の使用を避けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie eine grundlegende Routine bei und vermeiden Sie den Konsum von Alkohol oder anderen Mitteln, um Angstzuständen vorzubeugen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une routine de base et évitez de consommer de l’alcool ou d’autres moyens pour éviter l’anxiété."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga una rutina básica y evite el consumo de alcohol u otros medios para evitar la ansiedad."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "保持基本作息，不用酒精等方式迴避焦慮。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불안을 피하기 위해 기본적인 일상생활을 유지하고 알코올이나 기타 수단의 사용을 피하십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على روتين أساسي وتجنب استخدام الكحول أو أي وسيلة أخرى لتجنب القلق."
          }
        }
      }
    },
    "适合重视协作、服务质量和稳定推进的工作方式。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适合重视协作、服务质量和稳定推进的工作方式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suitable for work styles that value collaboration, service quality and stable advancement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コラボレーションやサービス品質、安定した昇進を重視する働き方に最適です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geeignet für Arbeitsstile, die Wert auf Zusammenarbeit, Servicequalität und stabile Weiterentwicklung legen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convient aux styles de travail qui valorisent la collaboration, la qualité du service et un avancement stable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adecuado para estilos de trabajo que valoran la colaboración, la calidad del servicio y el avance estable."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "適合重視協作、服務品質和穩定推廣的工作方式。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "협업, 서비스 품질, 안정적인 발전을 중시하는 업무 스타일에 적합합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مناسب لأنماط العمل التي تقدر التعاون وجودة الخدمة والتقدم المستقر."
          }
        }
      }
    },
