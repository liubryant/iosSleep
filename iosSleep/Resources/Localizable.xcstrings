          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proactively recover and aggregate more health data"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より多くの健康データをプロアクティブに回復して集約する"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
