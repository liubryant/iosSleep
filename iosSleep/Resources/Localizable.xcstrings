          "stringUnit": {
            "state": "translated",
            "value": "„Schöner Sex ist eine Fackel in der Sonne“ Bi Shumin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Le beau sexe est une torche au soleil\" Bi Shumin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"El sexo hermoso es una antorcha al sol\" Bi Shumin."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "《美好的性，是陽光下的火炬》畢淑敏."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"아름다운 섹스는 태양의 횃불이다\" 비슈민."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"الجنس الجميل هو شعلة في الشمس\" بي شومين."
          }
        }
      }
    },
    "我家啥都有，我家啥都乖": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我家啥都有，我家啥都乖"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My family has everything, my family is good at everything"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の家族は何でも持っていて、私の家族は何でも得意です"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meine Familie hat alles, meine Familie ist in allem gut"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma famille a tout, ma famille est bonne en tout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi familia lo tiene todo, mi familia es buena en todo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "我家啥都有，我家啥都乖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우리 가족은 모든 것을 가지고 있고, 우리 가족은 모든 것을 잘합니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عائلتي لديها كل شيء، عائلتي جيدة في كل شيء"
