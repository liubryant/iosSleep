    "让信任的人知道你的状态，避免独自承受。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让信任的人知道你的状态，避免独自承受。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let someone you trust know how you are doing to avoid going through it alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一人で乗り越えないよう、信頼できる人に自分の状況を知らせてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie jemanden, dem Sie vertrauen, wissen, wie es Ihnen geht, um nicht alleine durch die Krise zu gehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à quelqu’un en qui vous avez confiance comment vous allez pour éviter de vivre cette situation seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a alguien de su confianza cómo se encuentra para evitar pasar por esto solo."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "讓信任的人知道你的狀態，避免獨自承受。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "혼자 겪는 일을 피하기 위해 당신이 신뢰하는 사람에게 당신이 어떻게 지내고 있는지 알려주십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دع شخصًا تثق به يعرف ما تفعله لتجنب المرور به بمفردك."
          }
        }
      }
    },
    "退出App": {
