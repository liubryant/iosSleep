          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유롭게 정리할 수 있다면 중요한 일은 언제쯤 끝나나요?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
