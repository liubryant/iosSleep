    "起床后尽快接触自然光。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起床后尽快接触自然光。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose yourself to natural light as soon as possible after waking up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きたらできるだけ早く自然光を浴びましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie sich nach dem Aufwachen so bald wie möglich dem natürlichen Licht aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposez-vous à la lumière naturelle dès que possible après votre réveil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expóngase a la luz natural lo antes posible después de despertarse."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "起床後儘快接觸自然光。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠에서 깬 후 최대한 빨리 자연광에 노출시키세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعريض نفسك للضوء الطبيعي في أقرب وقت ممكن بعد الاستيقاظ."
          }
        }
      }
    },
    "如出现明显身体不适或安全风险，请及时就医。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如出现明显身体不适或安全风险，请及时就医。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you experience obvious physical discomfort or safety risks, please seek medical treatment promptly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明らかな身体的不快感や安全上のリスクを経験した場合は、直ちに医師の治療を受けてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie offensichtliche körperliche Beschwerden oder Sicherheitsrisiken verspüren, suchen Sie bitte umgehend einen Arzt auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous ressentez un inconfort physique évident ou des risques pour votre sécurité, veuillez consulter un médecin rapidement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si experimenta molestias físicas evidentes o riesgos de seguridad, busque tratamiento médico de inmediato."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "如出現明顯身體不適或安全風險，請及時就醫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명백한 신체적 불편이나 안전 위험을 경험하는 경우 즉시 치료를 받으십시오."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت تعاني من إزعاج جسدي واضح أو مخاطر تتعلق بالسلامة، فيرجى طلب العلاج الطبي على الفور."
          }
        }
      }
    },
    "睡眠阶段、恢复、心率与血氧": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠阶段、恢复、心率与血氧"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep stages, recovery, heart rate and blood oxygen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠段階、回復、心拍数、血中酸素"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlafphasen, Erholung, Herzfrequenz und Blutsauerstoff"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
