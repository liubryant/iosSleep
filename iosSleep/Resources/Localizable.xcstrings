    "观察细腻、适应力好，能用实际行动营造舒适和美感。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察细腻、适应力好，能用实际行动营造舒适和美感。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delicate observation, good adaptability, and able to use practical actions to create comfort and beauty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繊細な観察力と順応性があり、快適さと美しさを生み出す実践的な行動が可能です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feinfühlige Beobachtungsgabe, gute Anpassungsfähigkeit und die Fähigkeit, praktische Maßnahmen zu ergreifen, um Komfort und Schönheit zu schaffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observation délicate, bonne adaptabilité et capable d'utiliser des actions pratiques pour créer du confort et de la beauté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observación delicada, buena adaptabilidad y capacidad de utilizar acciones prácticas para crear comodidad y belleza."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察細膩、適應力好，能用實際行動營造舒適和美感。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섬세한 관찰력과 좋은 적응력, 그리고 실용적인 행동을 통해 편안함과 아름다움을 창조할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراقبة دقيقة وقدرة جيدة على التكيف وقادرة على استخدام الإجراءات العملية لخلق الراحة والجمال."
          }
        }
      }
    },
    "把结果当作观察起点，而不是固定标签。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把结果当作观察起点，而不是固定标签。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of results as starting points for observation, not fixed labels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は、固定されたラベルではなく、観察の開始点であると考えてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sich Ergebnisse als Ausgangspunkte für die Beobachtung vor, nicht als feste Etiketten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Considérez les résultats comme des points de départ pour l’observation, et non comme des étiquettes fixes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piense en los resultados como puntos de partida para la observación, no como etiquetas fijas."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把結果當作觀察起點，而不是固定標籤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 고정된 라벨이 아닌 관찰의 시작점으로 생각하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فكر في النتائج كنقاط بداية للملاحظة، وليس تسميات ثابتة."
          }
        }
      }
    },
    "大口呼吸": {
      "localizations": {
