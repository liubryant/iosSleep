    "枕着山海风雨，慢慢沉入梦乡": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "枕着山海风雨，慢慢沉入梦乡"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pillowing against the mountains, seas, wind and rain, slowly falling into sleep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山、海、風、雨を背に枕をしてゆっくり眠りにつく"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich gegen Berge, Meer, Wind und Regen kuscheln und langsam einschlafen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'oreiller contre les montagnes, la mer, le vent et la pluie, s'endormant lentement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acolchado contra las montañas, los mares, el viento y la lluvia, cayendo lentamente en el sueño."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "枕著山海風雨，慢慢沉入夢鄉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산과 바다, 바람과 비를 맞으며 베개를 베고 천천히 잠에 빠진다"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوسد على الجبال والبحار والرياح والمطر، وينام ببطء"
