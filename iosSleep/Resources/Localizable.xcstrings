    "面对难题时，客观分析通常比共情更能帮助我判断": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面对难题时，客观分析通常比共情更能帮助我判断"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When faced with difficult problems, objective analysis often helps me judge better than empathy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "難しい問題に直面したとき、共感よりも客観的な分析のほうが判断力に役立つことがよくあります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ich mit schwierigen Problemen konfrontiert bin, hilft mir eine objektive Analyse oft besser, ein Urteil zu fällen als Empathie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face à des problèmes difficiles, l’analyse objective m’aide souvent à mieux juger que l’empathie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando me enfrento a problemas difíciles, el análisis objetivo a menudo me ayuda a juzgar mejor que la empatía."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "面對難題時，客觀分析通常比共感更能幫助我判斷"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어려운 문제에 직면했을 때, 객관적인 분석은 공감보다 판단을 더 잘하는 데 도움이 되는 경우가 많습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما أواجه مشكلات صعبة، غالبًا ما يساعدني التحليل الموضوعي في الحكم بشكل أفضل من التعاطف."
          }
        }
      }
    },
    "短暂休息，恢复身心能量": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短暂休息，恢复身心能量"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a short break to restore physical and mental energy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し休憩して体力と精神力を回復しましょう"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie eine kurze Pause, um körperliche und geistige Energie wiederherzustellen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites une petite pause pour retrouver de l'énergie physique et mentale"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tómese un breve descanso para recuperar la energía física y mental."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "短暫休息，恢復身心能量"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 휴식을 취하여 육체적, 정신적 에너지를 회복하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خذ استراحة قصيرة لاستعادة طاقتك البدنية والعقلية"
          }
        }
      }
    },
    "回到当下": {
