    "认识声音的气质，选择更适合此刻的陪伴": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识声音的气质，选择更适合此刻的陪伴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand the temperament of the voice and choose a companion that is more suitable for the moment"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "声の気質を理解し、その瞬間により適した相手を選ぶ"
