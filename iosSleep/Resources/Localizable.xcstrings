        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠較穩定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면이 더 안정적입니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النوم أكثر استقرارا"
          }
        }
      }
    },
    "有感染力、同理心强，能够组织协作并帮助他人成长。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有感染力、同理心强，能够组织协作并帮助他人成长。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagious, empathetic, able to organize, collaborate and help others grow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝染性があり、共感力があり、組織化し、協力し、他の人の成長を助けることができます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansteckend, einfühlsam, in der Lage, sich zu organisieren, zusammenzuarbeiten und anderen beim Wachsen zu helfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagieux, empathique, capable de s'organiser, de collaborer et d'aider les autres à grandir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contagioso, empático, capaz de organizarse, colaborar y ayudar a otros a crecer."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "有感染力、同理心強，能夠組織協作並幫助他人成長。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전염성이 강하고 공감 능력이 뛰어나며 조직하고 협력하며 다른 사람의 성장을 도울 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معدي ومتعاطف وقادر على التنظيم والتعاون ومساعدة الآخرين على النمو."
          }
        }
      }
    },
    "看看身心是否超负荷": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看身心是否超负荷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See if your body and mind are overloaded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体と心に負担がかかっていないか確認してください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie, ob Ihr Körper und Geist überlastet sind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez si votre corps et votre esprit sont surchargés"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba si tu cuerpo y tu mente están sobrecargados"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "看看身心是否超負荷"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸과 마음이 과부하 상태인지 살펴보세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرفة ما إذا كان جسمك وعقلك مثقلين"
          }
        }
      }
    },
