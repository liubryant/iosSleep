          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر الاستعادة في النوم"
          }
        }
      }
    },
    "减少睡前信息摄入，练习缓慢呼吸。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少睡前信息摄入，练习缓慢呼吸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce your intake of information before bed and practice slow breathing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寝る前に情報を摂取する量を減らし、ゆっくりとした呼吸を実践してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzieren Sie die Informationsaufnahme vor dem Schlafengehen und üben Sie langsames Atmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez votre consommation d’informations avant de vous coucher et pratiquez une respiration lente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca su ingesta de información antes de acostarse y practique la respiración lenta."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "減少睡前資訊攝入，練習緩慢呼吸。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자리에 들기 전 정보 섭취를 줄이고 느린 호흡을 연습하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قلل من تناولك للمعلومات قبل النوم ومارس التنفس البطيء."
          }
        }
      }
    },
    "把明早要带的东西放到门边。今天的最后一件小事，就做到这里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把明早要带的东西放到门边。今天的最后一件小事，就做到这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the things you need to take tomorrow morning by the door. The last little thing today, just do it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の朝持っていく必要があるものをドアの近くに置きます。今日の最後の小さなことは、ここで実行してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die Dinge, die Sie morgen früh mitnehmen müssen, an die Tür. Die letzte Kleinigkeit heute, machen Sie es einfach hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez les choses que vous devez emporter demain matin près de la porte. La dernière petite chose aujourd’hui, faites-la ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja las cosas que necesitas llevar mañana por la mañana junto a la puerta. La última cosita de hoy, hazla aquí."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "把明早要帶的東西放到門邊。今天的最後一件小事，就做到這裡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 아침에 가져가야 할 물건을 문 앞에 놓아두세요. 오늘 마지막 작은 일은 여기서만 하세요."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع الأشياء التي تحتاج إلى أخذها صباح الغد بجوار الباب. آخر شيء صغير اليوم، فقط افعله هنا."
          }
        }
      }
    },
