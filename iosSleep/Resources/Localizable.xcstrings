    "向下滑动，遇见声音背后的他们": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滑动，遇见声音背后的他们"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down to meet the people behind the voices"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下にスクロールして、声の背後にいる人々に会ってください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrollen Sie nach unten, um die Menschen hinter den Stimmen kennenzulernen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites défiler vers le bas pour rencontrer les personnes derrière les voix"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplácese hacia abajo para conocer a las personas detrás de las voces."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "向下滑動，遇見聲音背後的他們"
          }
