          }
        }
      }
    },
    "决策果断、视野长远，能在挑战中建立秩序和行动方向。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "决策果断、视野长远，能在挑战中建立秩序和行动方向。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decisive decision-making, long-term vision, able to establish order and action direction in challenges."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "果断な意思決定、長期的なビジョン、課題における秩序と行動の方向性を確立できる。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschlossene Entscheidungen, langfristige Vision, in der Lage, bei Herausforderungen Ordnung und Handlungsrichtung zu schaffen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise de décision décisive, vision à long terme, capable d'établir de l'ordre et une direction d'action face aux défis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma de decisiones resolutivas, visión de largo plazo, capaz de establecer orden y dirección de acción en los desafíos."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "決策果斷、視野長遠，能在挑戰中建立秩序與行動方向。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결단력 있는 의사결정, 장기적인 비전을 가지고 도전과제에 대한 질서와 행동방향을 확립할 수 있습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتخاذ قرارات حاسمة، ورؤية طويلة المدى، وقادرة على إرساء النظام واتجاه العمل في التحديات."
          }
        }
      }
    },
