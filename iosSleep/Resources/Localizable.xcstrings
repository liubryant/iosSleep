    "做决定时，现实经验通常比灵感更可靠": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做决定时，现实经验通常比灵感更可靠"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-life experience is often more reliable than inspiration when making decisions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決断を下す際には、インスピレーションよりも現実の経験の方が信頼できることがよくあります"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahrungen aus dem wirklichen Leben sind bei der Entscheidungsfindung oft verlässlicher als Inspiration"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’expérience de la vie réelle est souvent plus fiable que l’inspiration pour prendre des décisions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La experiencia de la vida real suele ser más fiable que la inspiración a la hora de tomar decisiones"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "做決定時，現實經驗通常比靈感更可靠"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정을 내릴 때 실제 경험이 영감보다 더 신뢰할 수 있는 경우가 많습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غالبًا ما تكون تجربة الحياة الواقعية أكثر موثوقية من الإلهام عند اتخاذ القرارات"
          }
        }
      }
    },
